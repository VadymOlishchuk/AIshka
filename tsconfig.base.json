{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@aishka/core": [
        "./libs/core/src/index.ts"
      ],
      "@aishka/core/*": [
        "./libs/core/src/*"
      ],
      "@aishka/ui/*": [
        "./libs/ui/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".nx"
  ]
}
