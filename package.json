{
  "name": "aishka",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:all": "pnpm db:up && nx run-many -t serve --parallel=3",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "content:check": "tsx scripts/content-check.ts",
    "content:sync": "tsx scripts/content-sync.ts && tsx scripts/project-sync.ts",
    "project:sync": "tsx scripts/project-sync.ts",
    "emoji:sync": "tsx scripts/emoji-sync.ts",
    "docker:prod": "docker compose -f compose.yml up --build -d",
    "postinstall": "prisma generate",
    "db:down": "docker compose stop db"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "nx": "^23.1.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@node-rs/argon2",
      "@prisma/engines",
      "esbuild",
      "nx",
      "prisma"
    ]
  }
}
