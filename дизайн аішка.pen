            {
              "type": "text",
              "id": "ctPn0",
              "name": "Body",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Start with something ordinary — a candle on your kitchen table. The job is to move it through three steps: name the object, give it a clean scene, then write a prompt that leaves out the words that ruin the shot.",
