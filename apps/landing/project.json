{
  "name": "landing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/landing/src",
  "projectType": "application",
  "tags": ["scope:landing"],
  "implicitDependencies": ["ui"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "vite --host 0.0.0.0 --port 5174", "cwd": "apps/landing" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "vite build", "cwd": "apps/landing" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/landing/tsconfig.json", "cwd": "{workspaceRoot}" }
    }
  }
}
