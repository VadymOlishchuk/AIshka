{
  "name": "main",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/main/src",
  "projectType": "application",
  "tags": ["scope:web"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "vite --host 0.0.0.0 --port 5173", "cwd": "apps/main" }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "vite build", "cwd": "apps/main" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p apps/main/tsconfig.json", "cwd": "{workspaceRoot}" }
    }
  }
}
