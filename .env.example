# ─────────────────────────── База даних ───────────────────────────
#
# Локально (pnpm db:up піднімає Postgres на 5433):
DATABASE_URL="postgresql://aishka:aishka@localhost:5433/aishka?schema=public"
#
# На проді (compose.yml) застосунок ходить у контейнер db напряму — compose
# перекриває це значення сам.
#
# Supabase — ДВА різні рядки, і плутати їх не можна:
#   DATABASE_URL — Session pooler, сюди ходить застосунок.
#   DIRECT_URL   — пряме підключення, сюди ходять лише міграції.
# DIRECT_URL=""

# ─────────────────────────── Секрети ───────────────────────────
# Підпис access-токена. Згенерувати: openssl rand -base64 48
# ВАЖЛИВО: на проді має бути ІНШИЙ, ніж локально.
AUTH_JWT_SECRET="change-me-to-a-long-random-string-at-least-32-bytes"

# Публічна адреса застосунку — потрібна для посилань у листах.
APP_URL="http://localhost:3000"

# Вмикається на етапі оплати, коли з'явиться Stripe.
BILLING_ENABLED="false"

# Порт API. Веб проксіює /api сюди — з браузера все виглядає одним доменом.
API_PORT="3001"

# Лендінги стоять на піддоменах (promo.aishka.com) і після реєстрації ведуть на
# платформу (app.aishka.com). Щоб cookie сесії дожили до переходу, вони ставляться
# на батьківський домен. Локально лишай порожнім — на localhost порти ділять cookie.
COOKIE_DOMAIN=""

# Адреси застосунків одне для одного: лендінг веде на платформу після реєстрації,
# платформа веде на лендінг тих, у кого ще немає акаунта. Читаються Vite під час збірки.
VITE_MAIN_URL="http://localhost:5173"
VITE_LANDING_URL="http://localhost:5174"
