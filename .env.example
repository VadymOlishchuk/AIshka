# ─────────────────────────── База даних ───────────────────────────
#
# Локальна розробка (docker compose up -d піднімає Postgres на 5433):
DATABASE_URL="postgresql://aishka:aishka@localhost:5433/aishka?schema=public"
#
# Supabase — ДВА різні рядки, і плутати їх не можна:
#
#   DATABASE_URL — пул (Session pooler), сюди ходить застосунок.
#     postgresql://postgres.<ref>:<пароль>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   DIRECT_URL — пряме підключення, сюди ходять лише міграції.
#     postgresql://postgres:<пароль>@db.<ref>.supabase.co:5432/postgres
#
# Обидва рядки є в дашборді Supabase: Project Settings → Database → Connection string.
# Пароль там показується лише при створенні проєкту — збережи його одразу.
# DIRECT_URL=""

# ─────────────────────────── Секрети ───────────────────────────
# Підпис access-токена. Згенерувати: openssl rand -base64 48
# ВАЖЛИВО: на проді має бути ІНШИЙ, ніж локально.
AUTH_JWT_SECRET="change-me-to-a-long-random-string-at-least-32-bytes"

# Публічний URL застосунку (потрібен для листів і редіректів)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Вмикається на етапі оплати, коли з'явиться Stripe
BILLING_ENABLED="false"
