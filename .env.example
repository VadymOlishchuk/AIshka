# База даних (docker compose up -d піднімає її на порту 5433)
DATABASE_URL="postgresql://aishka:aishka@localhost:5433/aishka?schema=public"

# Підпис access-токена. Згенерувати: openssl rand -base64 48
AUTH_JWT_SECRET="change-me-to-a-long-random-string-at-least-32-bytes"

# Публічний URL застосунку (потрібен для листів і редіректів)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Вмикається на етапі 3, коли з'явиться Stripe
BILLING_ENABLED="false"
